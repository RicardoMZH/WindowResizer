<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WindowSizerWinUI.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel MaxWidth="780" HorizontalAlignment="Center" Margin="36,38" Spacing="20">
            <TextBlock Text="关于" FontSize="32" FontWeight="SemiBold" />
            <Border Background="{ThemeResource AppCardBrush}"
                    BorderBrush="{ThemeResource AppCardStrokeBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="24">
                <StackPanel Spacing="12">
                    <TextBlock Text="窗口尺寸调整器" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="为已打开的 Windows 应用设置指定的窗口尺寸。"
                               Foreground="{ThemeResource AppMutedBrush}" />
                    <TextBlock Text="支持常用分辨率预设，并可选择尺寸是否包含标题栏与边框。"
                               TextWrapping="Wrap" />
                    <TextBlock Text="使用 WinUI 3 与 Windows App SDK 构建。"
                               Foreground="{ThemeResource AppMutedBrush}" />
                    <TextBlock x:Name="VersionText"
                               Foreground="{ThemeResource AppMutedBrush}" />
                </StackPanel>
            </Border>
            <Border Background="{ThemeResource AppCardBrush}"
                    BorderBrush="{ThemeResource AppCardStrokeBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="24">
                <StackPanel Spacing="12">
                    <TextBlock Text="软件更新" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="从 GitHub Releases 查询最新发布版本。"
                               Foreground="{ThemeResource AppMutedBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="CheckUpdatesButton"
                                Content="检查更新"
                                Click="CheckUpdates_Click" />
                        <Button x:Name="OpenReleaseButton"
                                Content="查看并下载新版本"
                                Visibility="Collapsed"
                                Click="OpenRelease_Click" />
                    </StackPanel>
                    <TextBlock x:Name="UpdateStatus"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource AppMutedBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
