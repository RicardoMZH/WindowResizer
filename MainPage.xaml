<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WindowSizerWinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:shapes="using:Microsoft.UI.Xaml.Shapes">

    <ScrollViewer x:Name="PageScroll" HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto" SizeChanged="PageScroll_SizeChanged">
        <Grid x:Name="ContentRoot" MinWidth="720" HorizontalAlignment="Left" Margin="34,24,34,38">
            <StackPanel Spacing="17">
                <StackPanel Spacing="4" Margin="0,0,0,5">
                    <TextBlock Text="窗口调整" FontSize="32" FontWeight="SemiBold" />
                    <TextBlock Text="精确设置任务栏中应用窗口的尺寸与位置。"
                               Foreground="{ThemeResource AppMutedBrush}" FontSize="14" />
                </StackPanel>

                <TextBlock Text="尺寸范围" FontSize="19" FontWeight="SemiBold" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Background="{ThemeResource AppCardBrush}" BorderBrush="{ThemeResource AppCardStrokeBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="18">
                        <StackPanel Spacing="4">
                            <RadioButton x:Name="OuterMode" GroupName="SizeMode" Content="整个窗口" IsChecked="True" FontWeight="SemiBold" />
                            <TextBlock Text="包含标题栏与边框" Margin="30,0,0,0" Foreground="{ThemeResource AppMutedBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{ThemeResource AppCardBrush}" BorderBrush="{ThemeResource AppCardStrokeBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="18">
                        <StackPanel Spacing="4">
                            <RadioButton x:Name="ClientMode" GroupName="SizeMode" Content="内容区域" FontWeight="SemiBold" />
                            <TextBlock Text="不包含标题栏与边框" Margin="30,0,0,0" Foreground="{ThemeResource AppMutedBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Margin="0,9,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="目标窗口" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="仅显示任务栏中的窗口；拖动表头右侧的分隔线可调整列宽。"
                                   Foreground="{ThemeResource AppMutedBrush}" FontSize="12" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                        <Button Content="刷新" Click="RefreshButton_Click" />
                        <Button Content="选择本工具" Click="SelectSelfButton_Click" />
                        <Button x:Name="CaptureButton" Content="3 秒后捕获" Click="CaptureButton_Click" />
                    </StackPanel>
                </Grid>

                <Border Background="{ThemeResource AppCardBrush}"
                        BorderBrush="{ThemeResource AppCardStrokeBrush}"
                        BorderThickness="1" CornerRadius="12">
                    <ScrollViewer x:Name="TableViewport" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled" SizeChanged="TableViewport_SizeChanged">
                        <StackPanel x:Name="TableLayout" HorizontalAlignment="Left">
                            <Grid x:Name="TableHeader" Height="46" Background="{ThemeResource AppTableHeaderBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="300" /><ColumnDefinition Width="130" /><ColumnDefinition Width="105" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="窗口标题" Foreground="White" FontWeight="SemiBold"
                                           Margin="12,0" VerticalAlignment="Center" TextAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="程序" Foreground="White" FontWeight="SemiBold"
                                           Margin="12,0" VerticalAlignment="Center" TextAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="当前尺寸" Foreground="White" FontWeight="SemiBold"
                                           Margin="12,0" VerticalAlignment="Center" TextAlignment="Center" />
                                <primitives:Thumb Grid.Column="0" Tag="0" Style="{StaticResource AppHeaderSplitterStyle}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  ToolTipService.ToolTip="拖动调整列宽"
                                                  DragDelta="HeaderThumb_DragDelta" DragCompleted="HeaderThumb_DragCompleted" />
                                <primitives:Thumb Grid.Column="1" Tag="1" Style="{StaticResource AppHeaderSplitterStyle}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  ToolTipService.ToolTip="拖动调整列宽"
                                                  DragDelta="HeaderThumb_DragDelta" DragCompleted="HeaderThumb_DragCompleted" />
                                <primitives:Thumb Grid.Column="2" Tag="2" Style="{StaticResource AppHeaderSplitterStyle}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  ToolTipService.ToolTip="拖动调整列宽"
                                                  DragDelta="HeaderThumb_DragDelta" DragCompleted="HeaderThumb_DragCompleted" />
                            </Grid>
                            <ListView x:Name="WindowList" Height="260" SelectionMode="Single"
                                      SelectionChanged="WindowList_SelectionChanged"
                                      IsItemClickEnabled="True" ItemClick="WindowList_ItemClick"
                                      HorizontalContentAlignment="Stretch" BorderThickness="0">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Loaded="RowSurface_Loaded" Unloaded="RowSurface_Unloaded"
                                                PointerPressed="RowSurface_PointerPressed" MinHeight="43">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="42" /><RowDefinition Height="1" />
                                                </Grid.RowDefinitions>
                                                <Grid Loaded="WindowRowGrid_Loaded" Unloaded="WindowRowGrid_Unloaded">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="300" /><ColumnDefinition Width="130" /><ColumnDefinition Width="105" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                                               Margin="12,0" VerticalAlignment="Center" TextAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding ProcessName}" TextTrimming="CharacterEllipsis"
                                                               Margin="12,0" VerticalAlignment="Center" TextAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}"
                                                               Margin="12,0" VerticalAlignment="Center" TextAlignment="Center" />
                                                </Grid>
                                                <shapes:Line Grid.Row="1" X1="0" Y1="0" X2="535" Y2="0"
                                                             Stroke="{ThemeResource AppRowSeparatorBrush}"
                                                             StrokeThickness="1" StrokeDashArray="3,3"
                                                             Loaded="RowSeparator_Loaded" Unloaded="RowSeparator_Unloaded" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Border x:Name="SelectedFooter" Background="{ThemeResource AppTableFooterBrush}" Padding="14,12">
                                <TextBlock x:Name="SelectedInfo" Text="尚未选择窗口" TextWrapping="Wrap"
                                           Foreground="{ThemeResource AppTableFooterTextBrush}" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <TextBlock Text="目标分辨率" FontSize="19" FontWeight="SemiBold" Margin="0,8,0,0" />
                <Border Background="{ThemeResource AppCardBrush}"
                        BorderBrush="{ThemeResource AppCardStrokeBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="9">
                            <TextBlock Text="长宽比" Foreground="{ThemeResource AppMutedBrush}" />
                            <ComboBox x:Name="RatioBox" HorizontalAlignment="Stretch"
                                      SelectionChanged="RatioBox_SelectionChanged">
                                <ComboBoxItem Content="4:3" />
                                <ComboBoxItem Content="16:9" />
                                <ComboBoxItem Content="16:10" />
                                <ComboBoxItem Content="自定义比例" />
                            </ComboBox>
                            <TextBlock Text="常用分辨率" Foreground="{ThemeResource AppMutedBrush}" Margin="0,6,0,0" />
                            <ComboBox x:Name="PresetBox" HorizontalAlignment="Stretch"
                                      SelectionChanged="PresetBox_SelectionChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="9">
                            <TextBlock Text="宽 × 高（像素）" Foreground="{ThemeResource AppMutedBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <NumberBox x:Name="WidthBox" Width="142" Minimum="1" Maximum="32767"
                                           Value="1280" SpinButtonPlacementMode="Compact"
                                           ValueChanged="WidthBox_ValueChanged" />
                                <TextBlock Text="×" VerticalAlignment="Center" FontSize="20" />
                                <NumberBox x:Name="HeightBox" Width="142" Minimum="1" Maximum="32767"
                                           Value="720" SpinButtonPlacementMode="Compact"
                                           ValueChanged="HeightBox_ValueChanged" />
                            </StackPanel>
                            <TextBlock x:Name="RatioHint" Text="已锁定 16:9；修改宽或高会自动更新另一项。"
                                       Foreground="{ThemeResource AppMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <CheckBox x:Name="CenterAfterApply" Content="应用尺寸后居中" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9">
                        <Button Content="仅居中窗口" Click="CenterButton_Click" MinWidth="120" />
                        <Button Content="应用尺寸" Click="ApplyButton_Click"
                                Background="{ThemeResource AppAccentBrush}" Foreground="White"
                                MinWidth="132" Padding="20,10" />
                    </StackPanel>
                </Grid>
                <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
