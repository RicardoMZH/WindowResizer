<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WindowSizerWinUI.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="980" HorizontalAlignment="Center"
                    Margin="36,30,36,42" Spacing="26">
            <TextBlock Text="设置" FontSize="32" FontWeight="SemiBold" />

            <Grid ColumnSpacing="24" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="116" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="108" Height="108" CornerRadius="18"
                        Background="{ThemeResource AppCardBrush}"
                        BorderBrush="{ThemeResource AppCardStrokeBrush}"
                        BorderThickness="1" VerticalAlignment="Top">
                    <Image Source="Assets/AppIcon.png" Width="76" Height="76" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="窗口尺寸调整器" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="为已打开的 Windows 应用设置指定的窗口尺寸。"
                               FontSize="15" Foreground="{ThemeResource AppMutedBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="使用 WinUI 3 与 Windows App SDK 构建。"
                               Foreground="{ThemeResource AppMutedBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="-10,6,0,0">
                        <HyperlinkButton Content="文档"
                                         NavigateUri="https://github.com/RicardoMZH/WindowResizer/blob/main/README.md" />
                        <HyperlinkButton Content="GitHub 发布"
                                         NavigateUri="https://github.com/RicardoMZH/WindowResizer/releases" />
                        <HyperlinkButton Content="报告 bug"
                                         NavigateUri="https://github.com/RicardoMZH/WindowResizer/issues/new" />
                        <HyperlinkButton Content="申请功能"
                                         NavigateUri="https://github.com/RicardoMZH/WindowResizer/issues/new" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <StackPanel Spacing="12">
                <TextBlock Text="外观与语言" FontSize="20" FontWeight="SemiBold" />
                <Border Background="{ThemeResource AppCardBrush}"
                        BorderBrush="{ThemeResource AppCardStrokeBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="22">
                    <StackPanel Spacing="18">
                        <Grid ColumnSpacing="22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="230" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="界面语言" FontWeight="SemiBold" />
                                <TextBlock Text="选择应用中使用的语言；更改立即生效。"
                                           Foreground="{ThemeResource AppMutedBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="LanguageBox" Grid.Column="1"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="LanguageBox_SelectionChanged">
                                <ComboBoxItem Content="系统默认" />
                                <ComboBoxItem Content="简体中文" />
                                <ComboBoxItem Content="英语" />
                            </ComboBox>
                        </Grid>
                        <Border Height="1" Background="{ThemeResource AppCardStrokeBrush}" />
                        <Grid ColumnSpacing="22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="深色模式" FontWeight="SemiBold" />
                                <TextBlock Text="为应用使用深色外观。"
                                           Foreground="{ThemeResource AppMutedBrush}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="DarkModeToggle" Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Toggled="DarkModeToggle_Toggled" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="版本和更新" FontSize="20" FontWeight="SemiBold" />
                <Border Background="{ThemeResource AppCardBrush}"
                        BorderBrush="{ThemeResource AppCardStrokeBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="22">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE895;" FontSize="24"
                                  VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock x:Name="VersionText" FontWeight="SemiBold" FontSize="17" />
                            <TextBlock Text="从 GitHub Releases 查询最新发布版本。"
                                       Foreground="{ThemeResource AppMutedBrush}"
                                       TextWrapping="Wrap" />
                            <HyperlinkButton Content="发布说明" Margin="-10,0,0,0"
                                             HorizontalAlignment="Left"
                                             NavigateUri="https://github.com/RicardoMZH/WindowResizer/releases" />
                            <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap"
                                       Foreground="{ThemeResource AppMutedBrush}" />
                            <Button x:Name="OpenReleaseButton"
                                    Content="查看并下载新版本"
                                    Visibility="Collapsed"
                                    Click="OpenRelease_Click" />
                        </StackPanel>
                        <Button x:Name="CheckUpdatesButton" Grid.Column="2"
                                Content="检查更新" Click="CheckUpdates_Click"
                                Background="{ThemeResource AppAccentBrush}"
                                Foreground="White" MinWidth="132" Padding="20,10"
                                VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
