<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WindowSizerWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="窗口尺寸调整器">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="窗口尺寸调整器" Subtitle="Window Sizer">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        PaneDisplayMode="Left"
                        OpenPaneLength="250"
                        IsPaneOpen="True"
                        IsPaneToggleButtonVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="ResizeNav" Content="窗口调整" Icon="Home" Tag="resize" />
                <NavigationViewItem x:Name="AboutNav" Content="关于" Icon="Help" Tag="about" />
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <StackPanel Margin="18,4,18,18" Spacing="10">
                    <ToggleSwitch x:Name="DarkModeToggle"
                                  Header="深色模式"
                                  Toggled="DarkModeToggle_Toggled" />
                </StackPanel>
            </NavigationView.PaneFooter>
            <Frame x:Name="RootFrame" />
        </NavigationView>
    </Grid>
</Window>
